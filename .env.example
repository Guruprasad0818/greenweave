# ══════════════════════════════════════════════════════════════════
#  GreenWeave — environment template
#  Copy this file to .env and fill in real values:
#      cp .env.example .env
#  .env is gitignored — never commit real API keys.
# ══════════════════════════════════════════════════════════════════

# ── Module 1: Grid Monitor ────────────────────────────────────────
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here
ZONE=IN-SO

REDIS_HOST=redis
REDIS_PORT=6379

LOW_THRESHOLD=150
MODERATE_THRESHOLD=400

POLL_INTERVAL=300
REDIS_TTL=600

LOG_LEVEL=INFO

# ── Module 2: Elastic Router ──────────────────────────────────────

# Redis key — must match exactly what grid_monitor writes to Redis
# (see grid_monitor/app/redis_service.py / carbon_service.py for the zone/key)
REDIS_CARBON_KEY=carbon:IN-SO

# LLM API Keys (add whichever providers you're using — Groq is required
# for the default routing table in elastic_router/app/config.py)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Router behaviour
ROUTER_PORT=8000
MAX_TOKENS=1024
WEIGHT_PROFILE=BALANCED       # BALANCED | ECO_FIRST | ACCURACY_FIRST

# ── Module 4: Dashboard ───────────────────────────────────────────
ROUTER_URL=http://elastic_router:8000
